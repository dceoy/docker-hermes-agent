# Docker image reference used by Compose and buildx bake.
HERMES_IMAGE=dceoy/hermes-agent:local

# Dockerfile build args.
# Hermes Agent is installed via the upstream Nix flake.
HERMES_FLAKE_REF=github:NousResearch/hermes-agent
NIX_VERSION=2.30.3
HERMES_DEBIAN_RELEASE=trixie
HERMES_USER_NAME=hermes
HERMES_USER_UID=10000
HERMES_USER_GID=10000

# Runtime paths.
HERMES_DATA_DIR=./.hermes

# Networking.
HERMES_API_PORT=9118
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119
HERMES_TEAMS_PORT=3978

# OpenAI-compatible API server (set both to expose beyond localhost).
API_SERVER_HOST=
API_SERVER_KEY=

# Model and voice provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=

# Messaging gateways.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Microsoft Teams gateway.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_ALLOWED_USERS=
TEAMS_PORT=3978
